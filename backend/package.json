{
  "name": "horizonr-backend",
  "version": "1.0.0",
  "description": "API REST HorizonR — NovaTech Solutions RH",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "db:test:up": "docker-compose -f ../docker-compose.test.yml up -d --wait",
    "db:test:down": "docker-compose -f ../docker-compose.test.yml down -v"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.9.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "testPathIgnorePatterns": ["<rootDir>/tests/integration/"],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/app.js",
      "!src/routes/**"
    ]
  }
}
